<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tadeocar_description</name>
  <version>1.0.0</version>
  <description>TadeoeCar 4WS4WD robot description (URDF for TF tree)</description>

  <maintainer email="davidalvarezzzzzzzz@gmail.com">MrDavidAlv</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The description is a xacro, and the URDF/SDF consistency test expands
       it by running the xacro executable. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
