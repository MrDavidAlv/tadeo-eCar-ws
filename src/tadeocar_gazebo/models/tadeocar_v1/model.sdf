<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tadeocar">
    <static>false</static>

    <!-- ==================== BASE LINK ==================== -->
    <link name="base_link">
      <pose>0 0 0.1 0 0 0</pose>

      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>3.042</ixx>
          <iyy>6.375</iyy>
          <izz>8.667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 0.155 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/chassis/chasis_base.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="base_visual">
        <pose>0 0 0.155 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/chassis/chasis_base.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.8 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ==================== CHASIS SUPERIOR ==================== -->
    <link name="chasis_link">
      <pose>0 0 0.45 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
        <pose>0 0 -0.05 0 0 0</pose>
        <inertia>
          <ixx>0.433</ixx>
          <iyy>0.667</iyy>
          <izz>0.833</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="chasis_collision">
        <pose>-0.49 0.39 -0.126 1.5708 0 3.14159</pose>
        <geometry>
          <mesh>
            <uri>meshes/chassis/chasis.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="chasis_visual">
        <pose>-0.49 0.39 -0.126 1.5708 0 3.14159</pose>
        <geometry>
          <mesh>
            <uri>meshes/chassis/chasis.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="chasis_joint" type="fixed">
      <parent>base_link</parent>
      <child>chasis_link</child>
    </joint>

    <!-- ==================== FRONT LEFT STEERING ==================== -->
    <link name="front_left_steering_link">
      <pose>0.478 0.275 0.1 0 0 0</pose>

      <inertial>
        <mass>6.0</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="front_left_steering_collision">
        <pose>0 0 0.227 0 3.14159 3.14159</pose>
        <geometry>
          <mesh>
            <uri>meshes/suspension/suspension.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="front_left_steering_visual">
        <pose>0 0 0.227 0 3.14159 3.14159</pose>
        <geometry>
          <mesh>
            <uri>meshes/suspension/suspension.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.356</lower>
          <upper>2.356</upper>
          <effort>100</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>2.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== FRONT LEFT WHEEL ==================== -->
    <link name="front_left_wheel_link">
      <pose>0.528 0.275 0.1 0 0 0</pose>

      <inertial>
        <mass>6.0</mass>
