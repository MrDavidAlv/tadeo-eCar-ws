<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tadeocar_vslam</name>
  <version>1.0.0</version>
  <description>TadeoeCar Visual SLAM with RTAB-Map and ZED2i stereo camera</description>
  <maintainer email="davidalvarez33@gmail.com">axioma</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rtabmap_launch</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>
  <exec_depend>rtabmap_util</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
