Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 700
- Class: rviz_common/Views
  Expanded:
  - ''
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Tool Properties
  Expanded:
  - ''
  Name: Tool Properties
  Splitter Ratio: 0.6
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 40
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability: Transient Local
      History: Keep Last
      Reliability: Reliable
      Value: /robot_description
    Enabled: true
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
      Link Tree Style: Links in Alphabetic Order
    Mass Properties:
      Inertia: false
      Mass: false
    Name: Robot
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.6
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: false
    Tree: {}
    Update Interval: 0
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 60; 60
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: LiDAR scan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.02
    Style: Points
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Best Effort
      Value: /scan
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0.0
    Enabled: true
    Name: RTAB-Map 3D cloud
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 5
      Durability: Transient Local
      History: Keep Last
      Reliability: Best Effort
      Value: /cloud_map
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0.0
    Enabled: true
    Name: ZED 2i live cloud
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.02
    Style: Points
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Best Effort
      Value: /zed/zed_node/point_cloud/cloud_registered
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: RTAB-Map grid
    Resolution: 0
    Topic:
      Depth: 1
      Durability: Transient Local
      History: Keep Last
      Reliability: Reliable
      Value: /map
    Update Interval: 0
    Update Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Reliable
      Value: /map_updates
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: ZED 2i colour
    Normalize Range: true
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Best Effort
      Value: /zed/zed_node/rgb/image_rect_color
    Value: true
  - Angle Tolerance: 0.05
    Class: rviz_default_plugins/Odometry
    Covariance:
      Orientation:
        Alpha: 0.5
        Color: 255; 255; 127
        Offset: 1
        Scale: 1
        Value: Local
      Position:
        Alpha: 0.3
        Color: 204; 51; 204
        Scale: 1
      Value: false
    Enabled: true
    Keep: 200
    Name: Visual odometry
    Position Tolerance: 0.05
    Shape:
      Alpha: 1
      Color: 255; 90; 200
      Head Length: 0.12
      Head Radius: 0.06
      Shaft Length: 0.3
      Shaft Radius: 0.03
      Value: Arrow
    Topic:
      Depth: 20
      Durability: Volatile
      History: Keep Last
      Reliability: Best Effort
      Value: /odom_visual
    Value: true
  - Angle Tolerance: 0.05
    Class: rviz_default_plugins/Odometry
    Covariance:
      Orientation:
        Alpha: 0.5
        Color: 255; 255; 127
        Offset: 1
        Scale: 1
        Value: Local
      Position:
        Alpha: 0.3
        Color: 204; 51; 204
        Scale: 1
      Value: false
    Enabled: true
    Keep: 200
    Name: Fused pose (EKF)
    Position Tolerance: 0.05
    Shape:
      Alpha: 1
      Color: 0; 200; 120
      Head Length: 0.12
      Head Radius: 0.06
      Shaft Length: 0.3
      Shaft Radius: 0.03
      Value: Arrow
    Topic:
      Depth: 20
      Durability: Volatile
      History: Keep Last
      Reliability: Best Effort
      Value: /odometry/filtered
    Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 40; 45
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Reliable
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Orbit
      Near Clip Distance: 0.01
      Pitch: 0.75
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: []
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: ''
  Views:
    collapsed: false
  Width: 1720
  X: 60
  Y: 60
